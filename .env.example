# ============================================================
# 知行合一 · 任务与知识管理系统 —— 环境变量总清单(.env.example)
# 复制为 .env 后按需修改；未列出的变量一律走代码内置默认值。
# docker-compose.yaml 通过 env_file 注入，无需逐个再写 environment。
# ============================================================

# ---------- 邮箱(SMTP)：邮箱绑定验证码；未配置时校验码仅写日志 ----------
MAIL_SERVER=smtp.qq.com
MAIL_PORT=465
MAIL_USE_SSL=1
MAIL_USE_TLS=0
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_smtp_auth_code
MAIL_FROM=your_email@qq.com

# ---------- 授权 ----------
# born 必须等于 base64("MAIL_PASSWORD="+MAIL_USERNAME)，否则为演示版(拦截业务写入)
born=

# ---------- 功能开关(worker/检索/分类，默认值即低资源推荐值) ----------
# 大模型问答总开关：1=禁用，分身问答降级为关键词检索+FAQ(省内存大头)
KB_LLM_DISABLED=1
# 向量检索(fastembed+SochDB)：1=禁用，降级 SQLite 关键词匹配
KB_VECTOR_DISABLED=1
# fastText 自动分类(无模型自动降级关键词规则)
KB_CLASSIFIER_ENABLED=1
# 知识库源码热重载(开发便利，生产可设 0)
KB_AUTO_RELOAD=1
# 后台 worker 总开关(关闭可省约 20-200MB 内存)
KB_WORKER_ENABLED=1
REMINDER_WORKER_ENABLED=1
JOB_WORKER_ENABLED=1

# ---------- 周期与轮询(秒) ----------
# 邮件提醒扫描间隔(从 60 提至 300 减少空转)
REMINDER_INTERVAL=300
JOB_INTERVAL=60
KB_POLL_INTERVAL=
JOB_MAX_KBS=
JOB_MAX_NOTES=
JOB_RECOVER_MINUTES=

# ---------- LLM/OpenCode 分身服务 ----------
# 容器内经 compose 网络访问 opencode 分身；本地直连可改 http://127.0.0.1:3000
KB_OPENCODE_BASE_URL=http://opencode:3000
KB_OPENCODE_PROVIDER=
KB_OPENCODE_MODEL=
KB_OPENCODE_TIMEOUT=

# ---------- 自动装依赖(entrypoint.sh) ----------
# 启动时自动 pip 安装缺失依赖
KB_PREINSTALL=1
KB_AUTOPIP=1
# pip 超时秒数
KB_AUTOPIP_TIMEOUT=600
# pip 镜像源(留空用清华源默认)
KB_PIP_MIRROR=

# ---------- NLP/解析 ----------
# 时间解析器(jionlp 优先，异常自动降级 legacy 规则)
KB_TIME_PARSER=jionlp

# ---------- 向量库与模型路径 ----------
KB_EMBED_MODEL=
KB_SOCHDB_PATH=
KB_CACHE_PATH=

# ---------- 缓存 TTL(秒) ----------
KB_ASK_CACHE_TTL=
KB_SEARCH_CACHE_TTL=

# ---=== 以下为高级调优项，通常保持代码默认即可 ===---

# ---------- RAG 检索参数 ----------
# KB_ASK_TOP_K=4
# KB_ASK_TOKEN_LIMIT=
# KB_STALE_QUEUE_HOURS=
# KB_SUMMARY_MAX_CHARS=
# KB_MAX_DOC_ATTEMPTS=
# KB_AUTO_SUMMARY=1

# ---------- 分类器训练参数 ----------
# KB_CLASSIFIER_CONFIDENCE=
# KB_CLASSIFIER_MIN_SAMPLES=
# KB_CLASSIFIER_MAX_SAMPLES_PER_LABEL=
# KB_CLASSIFIER_MAX_TEXT_CHARS=
# KB_CLASSIFIER_RETRAIN_INTERVAL=

# ---------- OCR/PDF 抽取 ----------
# KB_OCR_DPI_SCALE=
# KB_OCR_MIN_SIDE=
# KB_OCR_MERGE_SHORT_MAX=
# KB_PDF_TEXT_MIN_CHARS=

# ---------- 知识点抽取/合并 ----------
# KB_POINT_MAX_CHARS=
# KB_POINT_MIN_CHARS=
# KB_POINT_MAX_REL=
# KB_POINT_SIM_THRESHOLD=
# KB_POINT_MERGE_THRESHOLD=
# KB_POINT_MERGE_POOL=
# KB_POINT_MERGE_MAX=

# ---------- 标签黑名单(逗号分隔) ----------
# KB_TAG_BLACKLIST=

# ---------- 笔记合并 ----------
# NOTE_MERGE_BATCH=
# NOTE_MERGE_THRESHOLD=

# ---------- 运行环境(一般由 docker-compose environment 固定，勿改) ----------
# TZ=Asia/Shanghai
# FLASK_ENV=production
# PYTHONOPTIMIZE=1
# FLASK_DEBUG=0
# LOG_LEVEL=INFO
# COOKIE_SECURE=0
# INSTANCE_DIR=
# BACKUP_DIR=
